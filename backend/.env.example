# Backend Environment Configuration
PORT=5000

# Database & Vector DB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/support_agent
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=support-knowledge-base

# AI / LLM & Web Research API
OPENAI_API_KEY=your_openai_api_key_or_gemini_api_key
GEMINI_API_KEY=your_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Authentication & Session Security
JWT_SECRET=your_jwt_secret_key_change_in_production

# Google OAuth 2.0 / OpenID Connect
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
